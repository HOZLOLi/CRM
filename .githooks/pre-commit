#!/bin/sh
# فیروزه — بررسی پیش از کامیت
# فعال‌سازی: npm run hooks:install
#
# ۱. typecheck
# ۲. تست‌های واحد
# ۳. به‌روزرسانی نقشهٔ دانش (graphify) و افزودن آن به همین کامیت
#    → گراف همیشه با همان کامیت همگام است، پس هر push گراف تازه دارد.
set -e

echo "→ typecheck…"
npx tsc --noEmit

echo "→ tests…"
npx vitest run --reporter=dot

# --- نقشهٔ دانش -------------------------------------------------------------
# همیشه، نه فقط وقتی «کد» عوض شده: یک تغییر نام فایل یا یک فایل پیکربندی هم
# گراف را کهنه می‌کند. هزینهٔ اجرای افزایشی چند ثانیه است.
if command -v graphify >/dev/null 2>&1; then
  echo "→ graphify update (نقشهٔ دانش)…"
  if graphify update . >/tmp/graphify-hook.log 2>&1; then
    git add graphify-out 2>/dev/null || true
    echo "  ✓ graphify-out سینک شد"
  else
    # گراف هرگز نباید مانع کار شود
    echo "  ⚠ graphify update ناموفق بود (کامیت ادامه می‌یابد) — /tmp/graphify-hook.log"
  fi
else
  echo "  ⚠ graphify نصب نیست — نقشهٔ دانش سینک نشد"
fi

echo "✓ checks passed"
