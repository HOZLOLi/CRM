# --- Database ---
# SQLite resolves this path relative to the prisma/ directory.
DATABASE_URL="file:../data/crm.db"
# PostgreSQL (multi-branch / cloud): change provider in prisma/schema.prisma
# DATABASE_URL="postgresql://user:pass@host:5432/crm?schema=public"

# --- Auth ---
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# --- Cookies ---
# auto (default) | true | false
# auto = Secure only when the request is HTTPS. Leave on auto:
#   LAN  http://192.168.1.50:3000  -> not Secure  (browsers accept it)
#   Tunnel https://crm.example.com -> Secure      (required)
COOKIE_SECURE="auto"

# --- Server ---
PORT="3000"
HOST="0.0.0.0"

# --- AI (OpenAI-compatible: OpenRouter / OpenAI / Ollama / LM Studio) ---
AI_BASE_URL="https://openrouter.ai/api/v1"
AI_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"
