{
  "name": "crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "start:prod": "node --env-file-if-exists=.env scripts/check-env.mjs && next start -H 0.0.0.0",
    "setup": "prisma generate && prisma db push && node --env-file-if-exists=.env prisma/seed.ts",
    "db:push": "prisma db push",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/react": "^4.0.174",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.19.3",
    "ai": "^7.0.170",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "motion": "^14.12.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
