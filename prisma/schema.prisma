// CRM — data model
// Provider is SQLite for zero-setup local development.
// To move to PostgreSQL: change provider to "postgresql" and update DATABASE_URL.
// Enums are avoided on purpose so the same schema works on both providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("rep") // admin | manager | rep
  title        String?
  avatarHue    Int      @default(180)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedCompanies  Company[]        @relation("CompanyOwner")
  ownedContacts   Contact[]        @relation("ContactOwner")
  ownedLeads      Lead[]           @relation("LeadOwner")
  ownedDeals      Deal[]           @relation("DealOwner")
  activities      Activity[]
  tasks           Task[]           @relation("TaskAssignee")
  notes           Note[]
  auditLogs       AuditLog[]
  aiConversations AiConversation[]

  createdOrders          Order[]                 @relation("OrderCreator")
  temperatureEvaluations TemperatureEvaluation[] @relation("TemperatureEvaluator")
  followUpTasks          FollowUpTask[]          @relation("FollowUpAssignee")
  settingsEdited         Setting[]               @relation("SettingEditor")
  decisions              DecisionLog[]
}

// ---------------------------------------------------------------- accounts

model Company {
  id                 String   @id @default(cuid())
  name               String
  domain             String?
  industry           String?
  size               String? // 1-10 | 11-50 | 51-200 | 201-1000 | 1000+
  phone              String?
  website            String?
  city               String?
  address            String?
  notes              String?
  ownerId            String?
  // --- دامنهٔ پخش عمده ---
  industryType       String? // restaurant | fastfood | catering | hall | heyat | other
  acquaintanceSource String? // visit | referral | inbound | campaign | other
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner      User?      @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]

  profile                CustomerProfile?
  orders                 Order[]                 @relation("CustomerOrders")
  temperatureEvaluations TemperatureEvaluation[]
  purchaseCycles         PurchaseCycle[]
  followUpTasks          FollowUpTask[]

  @@index([name])
  @@index([ownerId])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  mobile    String?
  title     String?
  companyId String?
  ownerId   String?
  tags      String? // comma separated
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner      User?      @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals      Deal[]
  activities Activity[]
  tasks      Task[]

  @@index([lastName])
  @@index([companyId])
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyName String?
  source      String   @default("manual") // manual | website | referral | campaign | inbound
  status      String   @default("new") // new | contacted | qualified | unqualified | converted
  score       Int      @default(0)
  notes       String?
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User? @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([ownerId])
}

// ---------------------------------------------------------------- pipeline

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  stages Stage[]
  deals  Deal[]
}

model Stage {
  id          String @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int    @default(0) // 0..100
  tone        String @default("turquoise") // design token name

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId, order])
}

model Deal {
  id                String    @id @default(cuid())
  title             String
  companyId         String?
  contactId         String?
  pipelineId        String?
  stageId           String?
  amount            Decimal   @default(0)
  currency          String    @default("IRR")
  probability       Int       @default(0)
  status            String    @default("open") // open | won | lost
  expectedCloseDate DateTime?
  closedAt          DateTime?
  lostReason        String?
  ownerId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pipeline Pipeline? @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage    Stage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  owner    User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  items      DealItem[]
  activities Activity[]
  tasks      Task[]

  @@index([stageId])
  @@index([status])
  @@index([ownerId])
}

model Product {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  unitPrice Decimal  @default(0) // قیمت فروش
  costPrice Decimal  @default(0) // قیمت خرید / تمام‌شده
  currency  String   @default("IRR")
  taxRate   Decimal  @default(0) // percent, e.g. 9.00
  unit      String   @default("بسته")
  packSize  Int?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items          DealItem[]
  orderItems     OrderItem[]
  purchaseCycles PurchaseCycle[]
  followUpTasks  FollowUpTask[]
}

model DealItem {
  id        String  @id @default(cuid())
  dealId    String
  productId String?
  name      String
  quantity  Decimal @default(1)
  unitPrice Decimal @default(0)
  discount  Decimal @default(0)
  taxRate   Decimal @default(0)

  deal    Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([dealId])
}

// ---------------------------------------------------------------- activity

model Activity {
  id         String   @id @default(cuid())
  type       String // call | meeting | email | note | stage_change | system
  subject    String
  body       String?
  dealId     String?
  contactId  String?
  companyId  String?
  userId     String?
  occurredAt DateTime @default(now())

  deal    Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([dealId])
  @@index([contactId])
  @@index([occurredAt])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  priority    String    @default("normal") // low | normal | high | urgent
  status      String    @default("open") // open | done | cancelled
  assigneeId  String?
  dealId      String?
  contactId   String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  assignee User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deal     Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([status, dueDate])
  @@index([assigneeId])
}

model Note {
  id         String   @id @default(cuid())
  body       String
  entityType String // company | contact | deal | lead
  entityId   String
  authorId   String?
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

// ---------------------------------------------------------------- ai

model AiConversation {
  id        String   @id @default(cuid())
  title     String   @default("گفتگوی جدید")
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | system
  content        String
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ---------------------------------------------------------------- audit

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String // create | update | delete
  diff       String? // JSON
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// موتور فروش دوره‌ای — دامنهٔ پخش عمده ظروف یکبارمصرف
// ============================================================================

model CustomerProfile {
  id        String @id @default(cuid())
  companyId String @unique

  // قانون حیاتی منع تماس
  contactAllowed   Boolean   @default(true)
  contactBlockedAt DateTime?
  blockReason      String?

  // پرونده رقبا
  competitorName    String?
  competitorLoyalty Int     @default(0) // 0..5
  switchReadiness   Int     @default(0) // 0..5

  // تاریخ توافق‌شده با مشتری — بر پیش‌بینی سیستم اولویت دارد
  agreedNextContact DateTime?
  agreedNote        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Order {
  id          String   @id @default(cuid())
  customerId  String
  number      String   @unique
  orderedAt   DateTime @default(now())
  status      String   @default("confirmed") // draft | confirmed | cancelled
  subtotal    Decimal  @default(0)
  totalCost   Decimal  @default(0)
  profit      Decimal  @default(0)
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Company     @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?       @relation("OrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderItem[]

  @@index([customerId, orderedAt])
  @@index([orderedAt])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  quantity      Decimal
  unitPrice     Decimal
  /**
   * عکس لحظه‌ای قیمت خرید — سود فاکتور دیروز با تغییر قیمت امروز عوض نمی‌شود
   */
  unitCostPrice Decimal
  lineRevenue   Decimal
  lineCost      Decimal
  lineProfit    Decimal

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model TemperatureEvaluation {
  id            String   @id @default(cuid())
  customerId    String
  rawScore      Int
  coveredMax    Int
  coverage      Decimal // 0..100
  isProvisional Boolean  @default(false)
  band          String // cold | warm | hot | veryHot
  /**
   * JSON: { criterionKey: { value, points, unknown } }
   */
  answers       String
  note          String?
  evaluatedById String?
  evaluatedAt   DateTime @default(now())

  customer    Company @relation(fields: [customerId], references: [id], onDelete: Cascade)
  evaluatedBy User?   @relation("TemperatureEvaluator", fields: [evaluatedById], references: [id], onDelete: SetNull)

  @@index([customerId, evaluatedAt])
}

model PurchaseCycle {
  id         String @id @default(cuid())
  customerId String
  productId  String

  medianCycleDays  Decimal?
  meanCycleDays    Decimal?
  sampleSize       Int       @default(0)
  totalQuantity    Decimal   @default(0)
  lastPurchaseAt   DateTime?
  expectedDate     DateTime?
  dailyConsumption Decimal   @default(0)
  estimatedStock   Decimal   @default(0)
  status           String    @default("learning") // learning | active | overdue
  computedAt       DateTime  @default(now())

  customer Company @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([expectedDate])
  @@index([status])
}

model FollowUpTask {
  id               String    @id @default(cuid())
  customerId       String
  productId        String?
  dueDate          DateTime
  stage            Int       @default(1) // ۱..۷
  channel          String    @default("call") // call | sms | whatsapp
  priority         String    @default("P3") // P1 | P2 | P3
  reason           String
  /**
   * JSON: ورودی‌هایی که به این تصمیم رسیدند
   */
  inputs           String?
  suggestedMessage String?
  status           String    @default("open") // open | done | skipped | blocked
  /** دلیل عدم خرید — price | quality | settlement | hasStock | competitor | other */
  objection        String?
  attempts         Int       @default(0)
  assigneeId       String?
  source           String    @default("cartable") // cartable | spacing | manual
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer Company  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  assignee User?    @relation("FollowUpAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, dueDate])
  @@index([assigneeId, status])
  @@index([customerId])
}

model DecisionLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  decision   String
  /**
   * JSON: { reasons: [], inputs: {} }
   */
  detail     String?
  userId     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String
  /**
   * JSON — شکلش با Zod در src/lib/settings-schema.ts اعتبارسنجی می‌شود
   */
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation("SettingEditor", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([group])
}
